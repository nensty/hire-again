import { test, expect } from "@playwright/test";
import AxeBuilder from "@axe-core/playwright";
test("find the supplied engineering manager post in seconds and preserve a shareable search", async ({
  page,
}) => {
  await page.goto("/?view=posts");
  await expect(page.locator(".person-result")).toHaveCount(13);
  await expect(page.getByRole("group", { name: "Directory view" })).toHaveCount(
    0,
  );
  await page.getByRole("searchbox").fill("Jamie manager");
  await expect(page.locator(".person-result")).toHaveCount(1);
  await expect(
    page
      .locator(".person-result")
      .getByRole("link", { name: "Read on LinkedIn" }),
  ).toHaveAttribute("href", "https://www.linkedin.com/posts/fictional-demo-7-000000000");
  await expect(page).toHaveURL(/q=Jamie/);
  await page.reload();
  await expect(page.getByRole("searchbox")).toHaveValue("Jamie manager");
  await expect(page.locator(".person-result")).toHaveCount(1);
  await page
    .getByRole("button", { name: "Clear filters", exact: true })
    .click();
  await expect(page.locator(".person-result")).toHaveCount(13);
  await page.getByText("Related community links", { exact: true }).click();
  await expect(
    page.getByRole("link", { name: "Shared LinkedIn discussion" }),
  ).toHaveAttribute("href", "https://www.linkedin.com/posts/fictional-demo-1-000000000");
});
test("one search finds both shared posts and self-published profiles", async ({
  page,
}) => {
  await page.goto("/");
  await page
    .getByRole("combobox", { name: "Specialty", exact: true })
    .selectOption("qa-automation");
  await expect(page.locator(".person-result")).toHaveCount(3);
  await page.getByRole("searchbox").fill("SDET");
  await expect(page.locator(".person-result")).toHaveCount(1);
  await expect(page.locator(".person-result")).toContainText(
    "Morgan Example",
  );
  await page
    .getByRole("button", { name: "Clear filters", exact: true })
    .click();
  await page.getByRole("searchbox").fill("Alex Morgan");
  await expect(page.locator(".person-result")).toHaveCount(1);
  await expect(page.locator(".person-result")).toContainText(
    "Added by this person",
  );
  await expect(
    page.getByRole("link", { name: "View profile", exact: true }),
  ).toHaveAttribute("href", "/people/alex-morgan-demo");
});
test("paste a list, review names and roles, and remove a mistaken entry before sharing", async ({
  page,
}) => {
  await page.goto("/add/post");
  await expect(
    page.getByText("No account needed.", { exact: false }),
  ).toBeVisible();
  await expect(page.getByLabel("Email address")).toHaveCount(0);
  await expect(
    page.getByLabel("LinkedIn post link", { exact: false }),
  ).toBeVisible();
  await expect(page.getByLabel("Person’s name", { exact: true })).toBeVisible();
  await expect(
    page.getByLabel("Person’s name", { exact: true }),
  ).toHaveAttribute("required", "");
  await page.getByRole("button", { name: "Paste a list", exact: true }).click();
  await page
    .getByLabel("Posts or comments")
    .fill(
      "Alex Example - Engineering Manager  https://lnkd.in/p/test-first\n\nTaylor Example - Backend Engineer (Python)  https://lnkd.in/p/test-second",
    );
  await page.getByRole("button", { name: "Review posts" }).click();
  await expect(page.locator(".import-row")).toHaveCount(2);
  await expect(page.getByLabel("Person / team name").first()).toHaveValue(
    "Alex Example",
  );
  await expect(page.getByLabel("Role", { exact: true }).last()).toHaveValue(
    "Backend Engineer (Python)",
  );
  await page
    .getByRole("button", { name: "Remove from this list" })
    .first()
    .click();
  await expect(page.locator(".import-row")).toHaveCount(1);
  await expect(
    page.getByRole("button", { name: "Share 1 post" }),
  ).toBeDisabled();
  await expect(
    page.getByText("Sharing is disabled in the fictional preview."),
  ).toBeVisible();
});
for (const width of [375, 430, 768, 1440])
  test(`posts are readable and accessible at ${width}px`, async ({ page }) => {
    await page.setViewportSize({ width, height: 950 });
    await page.goto("/?view=posts");
    await expect(page.locator(".person-result")).toHaveCount(13);
    expect(
      await page.evaluate(
        () => document.documentElement.scrollWidth <= innerWidth,
      ),
    ).toBe(true);
    const result = await new AxeBuilder({ page })
      .withTags(["wcag2a", "wcag2aa", "wcag21aa"])
      .analyze();
    expect(
      result.violations.map((v) => ({
        id: v.id,
        nodes: v.nodes.map((n) => n.target),
      })),
    ).toEqual([]);
    await page.screenshot({
      path: `test-results/posts-${width}.png`,
      fullPage: true,
    });
  });
